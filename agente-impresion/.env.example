# ── Configuración del agente (modo servicio / relay) ──
# El agente solo necesita la URL de tu API y su token. NINGUNA llave de base de
# datos vive aquí: toda la comunicación pasa por tu backend.
#
# Para PROBAR el hardware sin la nube no necesitas nada de esto:
#   npm run list
#   node src/cli.ts test "preview:"

# URL pública de tu app (Render en prod, o http://localhost:3000 en local)
LEOGIN_API_URL=http://localhost:3000

# Token del agente — se genera en el panel (POST /api/agent/register)
LEOGIN_AGENT_TOKEN=

# Intervalo de consulta en ms (opcional, por defecto 3000)
# LEOGIN_POLL_MS=3000
