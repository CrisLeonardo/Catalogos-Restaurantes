# ── Supabase (Project Settings → API) ────────────────────────────────
# Públicas (van al navegador, protegidas por RLS):
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Privada — SOLO servidor, NUNCA en el cliente (Super Admin / tareas privilegiadas):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Multi-tenant por subdominios ─────────────────────────────────────
# Dominio raíz de la plataforma. En producción: midominio.com
# En local puedes probar subdominios como: azucar-negra.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
