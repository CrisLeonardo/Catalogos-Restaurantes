{
  "name": "leogin-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "render:mobile": "remotion render src/index.ts LeoginPromoMobile out/leogin-mobile.mp4",
    "render:web": "remotion render src/index.ts LeoginPromoWeb out/leogin-web.mp4",
    "render:all": "npm run check && npm run render:mobile && npm run render:web"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@remotion/cli": "4.0.543",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.543",
    "typescript": "5.9.3"
  }
}
