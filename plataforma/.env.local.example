# ── Supabase (Project Settings → API) ────────────────────────────────
# Públicas (van al navegador, protegidas por RLS):
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Privada — SOLO servidor, NUNCA en el cliente (Super Admin / tareas privilegiadas):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Multi-tenant por subdominios ─────────────────────────────────────
# Dominio raíz de la plataforma (landing de Leogin). En producción: leogin.com
# En local puedes probar subdominios como: mi-restaurante.localhost:3000
# La demo pública vive en: demo.<ROOT_DOMAIN>  (ej. demo.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── Contacto de la landing (CTA "Solicita tu demo") ──────────────────
# Si defines el WhatsApp (solo dígitos con código de país), el botón abre wa.me.
# Si no, usa el correo. Cambia el correo por el tuyo.
NEXT_PUBLIC_CONTACT_EMAIL=crisleonardo100@gmail.com
# NEXT_PUBLIC_CONTACT_WHATSAPP=50212345678

# ── Web Push (VAPID) — notificaciones en la barra del sistema ─────────
# Genera un par de claves nuevas con: node -e "require('web-push').generateVAPIDKeys()"
# La clave PÚBLICA va al cliente (NEXT_PUBLIC_); la PRIVADA NUNCA.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BCqq1cRZVfDlRA_...
VAPID_PRIVATE_KEY=SbwATb--1noENa3Yh_...
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ── Login con Google para comensales (lealtad, opcional) ─────────────
# Actívalo SOLO tras completar la lista de chequeo de docs/GOOGLE_AUTH.md
# (proveedor Google en Supabase + redirect URLs). Sin esto, el botón no
# aparece y el flujo por teléfono sigue funcionando igual.
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1

# ── QZ Tray: firma para impresión silenciosa (SOLO servidor) ─────────
# Clave PRIVADA (RSA) en base64. Su certificado PÚBLICO va en src/lib/qz-cert.ts.
# Genera un par con:
#   openssl req -x509 -newkey rsa:2048 -keyout private-key.pem \
#     -out digital-certificate.txt -days 7300 -nodes -sha256 \
#     -subj "/C=GT/O=Leogin/CN=Leogin Print"
# Luego: base64 -w0 private-key.pem  →  pega aquí; el cert va en qz-cert.ts.
# Si se omite, la impresión funciona pero QZ pide permiso la 1ª vez por sesión.
QZ_PRIVATE_KEY_B64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0t...

# ── WhatsApp Cloud API (Fase 1A: avisos de estado del pedido) ────────
# El pedido se toma en el catálogo en línea; WhatsApp solo es el canal por
# el que el cliente se entera de cómo avanza. Leogin no contesta mensajes
# entrantes: a esos responde el restaurante desde su WhatsApp Business.
#
# Sin estas variables el canal simplemente no opera: no se rompe nada, los
# avisos no se mandan y el resto del sistema sigue igual.
#
# 1) Verificación del webhook. Lo inventas tú; tiene que ser EL MISMO que
#    escribas en Meta → App → WhatsApp → Configuración → Webhook.
WHATSAPP_VERIFY_TOKEN=una-cadena-larga-que-inventes
#
# 2) App secret de la app de Meta (Configuración básica). Con él se valida la
#    firma X-Hub-Signature-256 de cada webhook: sin esto, cualquiera que
#    descubra la URL podría inyectar mensajes falsos.
WHATSAPP_APP_SECRET=abc123...
#
# 3) Clave para cifrar el token de cada restaurante en la base (AES-256-GCM,
#    32 bytes). Genérala con:  openssl rand -base64 32
#    Si la pierdes o la rotas, los tokens ya guardados dejan de descifrarse y
#    hay que reconectar cada número.
#    Desde la Fase 3 la clave se llama LEOGIN_SECRET_KEY (más abajo) porque ya
#    no es solo de WhatsApp. Este nombre se sigue aceptando para no romper los
#    despliegues que ya lo tienen puesto: define UNA de las dos, no las dos.
WHATSAPP_TOKEN_KEY=
#
# 4) Opcionales.
# Nombre de la plantilla aprobada en Meta para avisos de estado (4 variables:
# nombre, número de pedido, restaurante, estado). Default: leogin_estado_pedido
# WHATSAPP_STATUS_TEMPLATE=leogin_estado_pedido
# Versión de la Graph API, por si Meta saca una nueva. Default: v21.0
# WHATSAPP_GRAPH_VERSION=v21.0

# ── Caja fuerte de secretos de terceros (Fase 3) ─────────────────────
# Clave maestra (AES-256-GCM, 32 bytes) con la que se cifran en la base los
# secretos que Leogin guarda POR CUENTA del restaurante: el token de WhatsApp
# y las credenciales del certificador FEL.
#   openssl rand -base64 32
#
# Sustituye a WHATSAPP_TOKEN_KEY (que se sigue aceptando). Si ya tienes un
# valor en WHATSAPP_TOKEN_KEY, COPIA EL MISMO aquí: una clave distinta deja
# ilegibles los tokens de WhatsApp ya guardados.
#
# Sin esta clave el modo MANUAL de facturación sigue funcionando; lo que no se
# puede es guardar credenciales de certificador.
LEOGIN_SECRET_KEY=

# ── FEL: certificador y cola de reintentos (Fase 3) ──────────────────
# Secreto del disparador de la cola: POST /api/fel/cola con
#   Authorization: Bearer <FEL_CRON_SECRET>
# Sin él, el endpoint responde 401 siempre (cerrado por defecto). Configúralo
# como cron job en Render cada 5 minutos.
#   openssl rand -base64 32
FEL_CRON_SECRET=

# Endpoints de INFILE. Solo defínelos si tu onboarding indica otros distintos
# a los de por defecto (por ejemplo, hosts propios de ambiente de pruebas).
# FEL_INFILE_URL_FIRMA=https://signer-emisores.feel.com.gt/sign_solicitud_firmas/firma_xml
# FEL_INFILE_URL_CERTIFICACION=https://certificador.feel.com.gt/fel/certificacion/v2/dte/
